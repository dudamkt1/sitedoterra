# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Sandbox/Teste — sk_test_ / pk_test_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================================================
# CLOUDFLARE R2 — ARMAZENAMENTO CENTRAL DE MÍDIA (somente no servidor)
# ----------------------------------------------------------------------------
# R2 = arquivos/mídia · Supabase = banco/metadados · Vercel = aplicação.
# NUNCA exponha estas credenciais no frontend/browser.
# Como criar: https://dash.cloudflare.com → R2 → Criar bucket (ex.: site-doterra-media)
#   -> Manage R2 API Tokens -> Create API Token (só o bucket) -> copie as chaves.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=site-doterra-media
# URL pública/CDN das imagens (aponta para o bucket via Custom Domain do R2).
# Ex.: https://media.sitedoterra.com.br  (deixe vazio para usar o r2.dev temporário)
R2_PUBLIC_URL=
# Opcional: endpoint manual (padrão: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com)
#R2_ENDPOINT=

# Price IDs criados no Stripe (Sandbox)
# R$ 297,00 — ativação do site (pagamento único / one-time)
STRIPE_ACTIVATION_PRICE_ID=
# R$ 47,00 — mensalidade recorrente
STRIPE_MONTHLY_PRICE_ID=

# Plataforma (deve apontar para a URL de produção no Vercel)
NEXT_PUBLIC_APP_URL=https://sitedoterra-psi.vercel.app

# Vercel (custom domains / DNS)
VERCEL_PROJECT_ID=
VERCEL_API_TOKEN=

# Super Admin (email que recebe papel de superadmin)
SUPER_ADMIN_EMAILS=contato@example.com,superadmin.teste@exemplo.com

# ============================================================================
# CONTAS DE TESTE (ACESSO RÁPIDO)
# ----------------------------------------------------------------------------
# Habilitar os botões "ACESSO RÁPIDO" na tela de login:
#   ENABLE_TEST_ACCOUNTS=true        -> gate de autorização (server-side)
#   NEXT_PUBLIC_ENABLE_TEST_ACCOUNTS=true  -> visibilidade dos botões (frontend)
# Com ENABLE_TEST_ACCOUNTS=false os botões NÃO aparecem e a API retorna 403.
# Nunca use senhas reais. Nunca commite estas credenciais (ficam em .env).
ENABLE_TEST_ACCOUNTS=false
NEXT_PUBLIC_ENABLE_TEST_ACCOUNTS=false

# Credenciais das contas de teste (ficam SOMENTE no servidor / .env)
TEST_SUPERADMIN_EMAIL=superadmin.teste@exemplo.com
TEST_SUPERADMIN_PASSWORD=change-me
TEST_USER_EMAIL=cliente.teste@exemplo.com
TEST_USER_PASSWORD=change-me
