# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Sandbox/Teste — sk_test_ / pk_test_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Price IDs criados no Stripe (Sandbox)
# R$ 297,00 — ativação do site (pagamento único / one-time)
STRIPE_ACTIVATION_PRICE_ID=
# R$ 47,00 — mensalidade recorrente
STRIPE_MONTHLY_PRICE_ID=

# Plataforma (deve apontar para a URL de produção no Vercel)
NEXT_PUBLIC_APP_URL=https://sitedoterra-psi.vercel.app

# Vercel (custom domains / DNS)
VERCEL_PROJECT_ID=
VERCEL_API_TOKEN=

# Super Admin (email que recebe papel de superadmin)
SUPER_ADMIN_EMAILS=contato@example.com
